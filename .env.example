# ─── TranscripTonic ──────────────────────────────────────────────────────────
TRANSCRIPTONIC_WEBHOOK_SECRET=your_transcriptonic_webhook_secret_here

# ─── LLM: OpenAI-compatible endpoint ─────────────────────────────────────────
# LM_STUDIO_URL is the base; the client appends /v1/chat/completions.
# Leave LM_STUDIO_API_KEY empty for keyless backends (LM Studio); set it for
# hosted providers that require a Bearer token (e.g. MiniMax).
#
# MiniMax:
LM_STUDIO_URL=https://api.minimax.io
LM_MODEL=MiniMax-M3
LM_STUDIO_API_KEY=your_minimax_api_key_here
#
# LM Studio (local):
# LM_STUDIO_URL=http://localhost:1234
# LM_MODEL=qwen3-27b-instruct
# LM_STUDIO_API_KEY=

# ─── LM Studio model lifecycle (local backends only) ─────────────────────────
# When true, skribbl loads LM_MODEL before processing a meeting and unloads it
# when the meeting is done, so the model only occupies VRAM while it is working.
# Requires the `lms` CLI. Leave false for hosted backends like MiniMax.
LM_MANAGE_MODEL=false
# Path to the lms CLI. Default: ~/.lmstudio/bin/lms
#LMS_BIN=/Users/you/.lmstudio/bin/lms
# Context window to load the model with. LM Studio's per-model default is often
# 8192, which truncates a full meeting transcript. 0 = use the model's default.
LM_CONTEXT_LENGTH=32768
# Safety net: if skribbl dies between load and unload, LM Studio unloads the
# model itself after this many idle seconds. 0 = no TTL.
LM_TTL=900

# ─── Obsidian vault ───────────────────────────────────────────────────────────
VAULT_PATH=/Users/jadfis/vaults/meetings

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5050
DEBUG=false
