# ─── TranscripTonic ──────────────────────────────────────────────────────────
TRANSCRIPTONIC_WEBHOOK_SECRET=your_transcriptonic_webhook_secret_here

# ─── LLM: OpenAI-compatible endpoint ─────────────────────────────────────────
# LM_STUDIO_URL is the base; the client appends /v1/chat/completions.
# Leave LM_STUDIO_API_KEY empty for keyless backends (LM Studio); set it for
# hosted providers that require a Bearer token (e.g. MiniMax).
#
# MiniMax:
LM_STUDIO_URL=https://api.minimax.io
LM_MODEL=MiniMax-M3
LM_STUDIO_API_KEY=your_minimax_api_key_here
#
# LM Studio (local):
# LM_STUDIO_URL=http://localhost:1234
# LM_MODEL=qwen3-27b-instruct
# LM_STUDIO_API_KEY=

# ─── Obsidian vault ───────────────────────────────────────────────────────────
VAULT_PATH=/Users/jadfis/vaults/meetings

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5050
DEBUG=false
